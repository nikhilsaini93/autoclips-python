# Telegram (required)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=your-chat-id-here
# Optional allowlist, comma-separated chat IDs. Defaults to TELEGRAM_CHAT_ID when empty.
TELEGRAM_ALLOWED_CHAT_IDS=

# Gemini (only required for /clips/analyze and /clips/viral)
GEMINI_API_KEY=your-gemini-key-here

# Whisper (CPU defaults; small is much better for Hindi/Hinglish than base,
# at ~2-4x the transcription cost — override as needed)
# On a GPU/CUDA (e.g. Google Colab T4): device=cuda, compute=float16,
# model=large-v3-turbo (same quality as large-v3, ~2x faster, ~4GB VRAM).
# Expected ~5-10x faster than CPU int8.
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# VAD removes silence/hallucinations and gives cleaner word boundaries.
# WHISPER_VAD_FILTER=true
# WHISPER_MIN_SILENCE_MS=400
# WHISPER_SPEECH_PAD_MS=200

# Face pipeline (T4): yolo (needs ultralytics) > yunet (no new dep) > res10 (legacy).
# FACE_MODEL=yolo
# FACE_SAMPLE_FPS=1.0
# FACE_SMOOTH_WINDOW=5
# SMOOTH_CROP=true
# Snap AI cuts to sentence ends / silences instead of mid-word.
# SNAP_TO_SILENCE=true
# SNAP_WINDOW_SEC=0.8

# ffmpeg (override as needed)
FFMPEG_PRESET=veryfast
# Bounded encode + Telegram cap (fixes 78-108MB unsendable clips).
# RENDER_CRF=20
# RENDER_AUDIO_BITRATE=128k
# RENDER_FPS=30
# TELEGRAM_MAX_VIDEO_MB=50.0
# MAX_CLIP_DURATION_SEC=60.0
# MIN_CLIP_DURATION_SEC=15.0
# Optional guard for POST /admin/cleanup?token=...
# ADMIN_TOKEN=change-me

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional: path to YouTube cookies file for yt-dlp (REQUIRED on Colab/Kaggle/cloud
# where YouTube returns "Sign in to confirm you're not a bot").
# How to get it: desktop Chrome/Firefox logged into YouTube → extension
# "Get cookies.txt LOCALES" → export youtube.com cookies → save as cookies.txt.
# Colab: upload to /content/drive/MyDrive/autoclips-config/cookies.txt (auto-wired
# by colab_setup.ipynb). Kaggle: upload to /kaggle/working/cookies.txt.
# YOUTUBE_COOKIES_FILE=cookies.txt

# YouTube uploads (only needed for Telegram Approve → Unlisted upload).
# Setup: Google Cloud project → enable YouTube Data API v3 → OAuth consent
# (External) → OAuth client (Desktop) → python scripts/get_youtube_token.py
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# Category: 22 = People & Blogs (default), 24 = Entertainment, 28 = Science & Tech
YT_CATEGORY_ID=22

# Meta uploads (only needed for Telegram Approve → Instagram / Facebook).
# Setup: Meta App + Facebook Page linked to IG Professional account →
# python scripts/get_meta_token.py (see docs/META_SETUP.md).
META_APP_ID=
META_APP_SECRET=
# Long-lived Page access token (60 days; re-run helper to refresh).
META_PAGE_TOKEN=
FB_PAGE_ID=
IG_USER_ID=
# META_API_VERSION=v26.0
# Share IG reels to feed as well as Reels tab (true/false).
# META_IG_SHARE_TO_FEED=true
# FB Reels must be 3-90s; longer clips fall back to a regular Page video post.
# META_FB_FALLBACK_TO_VIDEO=true


